# Lazy collections
#
# The values of the lazy collections may be `lazy` objects; reading a value
# computes it, so the collections are typed by the computed values.

class ldict(pdict[_K, _V]):
    """A persistent dictionary whose `lazy` values are computed when read."""
    @overload
    def __new__(cls) -> Self: ...  # pyright: ignore[reportOverlappingOverload]
    @overload
    def __new__(cls, **kwargs: _V | lazy[_V]) -> ldict[str, _V]: ...
    @overload
    def __new__(cls, map: Mapping[_K, _V | lazy[_V]], /) -> Self: ...
    @overload
    def __new__(cls, map: Mapping[str, _V | lazy[_V]],
                /, **kwargs: _V | lazy[_V]) -> ldict[str, _V]: ...
    @overload
    def __new__(cls, iterable: Iterable[tuple[_K, _V | lazy[_V]]], /
                ) -> Self: ...
    def set(self, key: _K, val: _V | lazy[_V], /) -> Self: ...
    def transient(self) -> tldict[_K, _V]: ...
    @overload
    def getlazy(self, key: _K, default: None = None, /
                ) -> _V | lazy[_V] | None: ...
    @overload
    def getlazy(self, key: _K, default: _T, /) -> _V | lazy[_V] | _T: ...
    def is_lazy(self, key: _K, /) -> bool: ...
    def is_ready(self, key: _K, /) -> bool: ...
    def ready_all(self) -> Self: ...
    def held_pdict(self) -> pdict[_K, _V | lazy[_V]]: ...


