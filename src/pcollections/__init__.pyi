# Type stubs for pcollections.
#
# The public types come from either the C backend or the pure-Python backend
# at import time; these stubs describe the interface that both provide.

from collections.abc import (
    Callable, Hashable, ItemsView, Iterable, Iterator, KeysView, Mapping,
    MutableMapping, MutableSequence, MutableSet, Sequence, Set, ValuesView)
from types import TracebackType
from typing import (
    Any, ClassVar, Generic, Literal, Protocol, SupportsIndex, TypeVar,
    overload)

from typing_extensions import Self, disjoint_base

_T = TypeVar("_T")
_S = TypeVar("_S")
_K = TypeVar("_K")
_V = TypeVar("_V")
_T_co = TypeVar("_T_co", covariant=True)
_V_co = TypeVar("_V_co", covariant=True)

__version__: str
using_c_extension: bool
backend_error: BaseException | None


class _SupportsKeysAndGetItem(Protocol[_K, _V_co]):
    def keys(self) -> Iterable[_K]: ...
    def __getitem__(self, key: _K, /) -> _V_co: ...


